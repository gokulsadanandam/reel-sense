# Copy to .env.local and fill in.

# --- Supabase -------------------------------------------------------------
# Local: printed by `npm run db:start` (or `npx supabase status`).
SUPABASE_URL=http://127.0.0.1:54321
# Used by the web app (read-only through RLS).
SUPABASE_ANON_KEY=
# Used ONLY by `npm run ingest` (writes movies). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- TMDB (movie data) ----------------------------------------------------
# themoviedb.org -> Settings -> API -> "API Read Access Token"
TMDB_READ_TOKEN=
# Which movies: >= INGEST_MIN_VOTES votes from every year since INGEST_START_YEAR,
# plus >= INGEST_RECENT_MIN_VOTES votes for the last INGEST_RECENT_YEARS years (~9.3k movies).
INGEST_START_YEAR=1920
INGEST_MIN_VOTES=500
INGEST_RECENT_YEARS=2
INGEST_RECENT_MIN_VOTES=50
# Regional cinema gets far fewer TMDB votes (no Tamil film has 500). These languages also get
# every film with >= INGEST_EXTRA_MIN_VOTES votes. ta,hi,te,ml,kn adds ~2.2k movies.
INGEST_EXTRA_LANGUAGES=ta,hi,te,ml,kn
INGEST_EXTRA_MIN_VOTES=20
# Optional: INGEST_DRY_RUN=true (count only), INGEST_MAX=50 (small test), INGEST_REFRESH=true (redo all)
TMDB_CONCURRENCY=2

# --- AI providers ---------------------------------------------------------
# Chat (search planning + answers): replicate | ollama | anthropic
AI_PROVIDER=replicate
# Embeddings: replicate | ollama | voyage
# All defaults below produce 1024-dim vectors, matching the database column.
# If you switch embedding provider, re-run the ingest. Vectors from
# different models can't be compared with each other.
EMBED_PROVIDER=replicate

# Ollama (free, local): `ollama pull llama3.1:8b && ollama pull mxbai-embed-large`
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=mxbai-embed-large

# Replicate (pay per use): replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Official model, no version hash needed. For cheaper testing: meta/meta-llama-3-8b-instruct
REPLICATE_CHAT_MODEL=meta/meta-llama-3-70b-instruct
# Community model, so it needs the version hash: open the model page -> "Versions" tab,
# copy the latest hash, and paste it as owner/name:hash. Outputs 1024-dim vectors.
REPLICATE_EMBED_MODEL=beautyyuyanli/multilingual-e5-large:a06276a89f1a902d5fc225a9ca32b6e8e6292b7f3b136518878da97c458e2bad

# Anthropic Claude (pay per use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Voyage AI embeddings
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
